@model DoyamoyeeMondir.Web.Models.PayrollForm
@{ ViewData["Title"]="বেতন নথিভুক্ত করুন"; DoyamoyeeMondir.Domain.Entities.Employee e=ViewBag.Employee; }
<div class="container-xl py-4"><h1>বেতন নথিভুক্ত করুন</h1><p>@e.NameBn — মূল বেতন: @e.MonthlySalary.ToString("N2") টাকা</p>
<p>প্রদেয় বেতন = মূল বেতন + ভাতা − কর্তন। আংশিক মাসের সমন্বয় ভাতা বা কর্তনে লিখুন। এটি ব্যয় তৈরি করবে; অর্থ পরিশোধ ব্যয়ের খাতা থেকে করতে হবে।</p>
<form asp-action="Generate" method="post" class="card card-body" style="max-width:640px"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="EmployeeId" type="hidden"/><input asp-for="EmployeeVersion" type="hidden"/><input asp-for="SubmissionKey" type="hidden"/>
<label asp-for="Month">বেতনের মাস (মাসের প্রথম দিন)</label><input asp-for="Month" type="date" class="form-control mb-3"/>
<label asp-for="Date">ব্যয়ের তারিখ</label><input asp-for="Date" type="date" class="form-control mb-3"/>
<label asp-for="ExpenseCategoryId">ব্যয়ের ধরন (এই ধরনের অনুমোদনের নিয়ম প্রযোজ্য)</label><select asp-for="ExpenseCategoryId" asp-items="ViewBag.Categories" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="Allowance">ভাতা (টাকা)</label><input asp-for="Allowance" type="number" min="0" step="0.01" class="form-control mb-3"/>
<label asp-for="Deduction">কর্তন (টাকা)</label><input asp-for="Deduction" type="number" min="0" step="0.01" class="form-control mb-3"/>
<div><button class="btn btn-primary">বেতন নথিভুক্ত করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
