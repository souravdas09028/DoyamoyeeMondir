@model DoyamoyeeMondir.Web.Models.EmployeeForm
@{ ViewData["Title"]="কর্মীর তথ্য"; }
<div class="container-xl py-4"><h1>কর্মীর তথ্য</h1><form asp-action="Edit" method="post" class="card card-body mt-3" style="max-width:640px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/>
<label asp-for="NameBn">নাম</label><input asp-for="NameBn" class="form-control mb-3"/>
<label asp-for="Position">পদবি</label><input asp-for="Position" class="form-control mb-3"/>
<label asp-for="Mobile">মোবাইল (ঐচ্ছিক)</label><input asp-for="Mobile" class="form-control mb-3"/>
<label asp-for="MonthlySalary">মাসিক মূল বেতন (টাকা)</label><input asp-for="MonthlySalary" type="number" min="0" step="0.01" class="form-control mb-3"/>
<label asp-for="JoinedOn">যোগদানের তারিখ</label><input asp-for="JoinedOn" type="date" class="form-control mb-3"/>
<label class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><span class="form-check-label">সক্রিয়</span></label>
<div><button class="btn btn-primary">সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
