@model DoyamoyeeMondir.Web.Models.MembershipForm
@{ ViewData["Title"] = "সদস্যপদ নিবন্ধন"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1>
<form method="post" asp-action="Create" class="card card-body mt-3" style="max-width:720px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="SubmissionKey" type="hidden"/>
<label asp-for="PersonId" class="form-label">ব্যক্তি</label><select asp-for="PersonId" asp-items="ViewBag.People" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="MembershipTypeId" class="form-label">সদস্যপদের ধরন ও নির্ধারিত টাকা</label><select asp-for="MembershipTypeId" asp-items="ViewBag.Types" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="StartDate" class="form-label">শুরুর তারিখ</label><input asp-for="StartDate" type="date" class="form-control mb-3"/>
<label asp-for="EndDate" class="form-label">শেষ তারিখ (ঐচ্ছিক)</label><input asp-for="EndDate" type="date" class="form-control mb-3"/>
<p>এই নিবন্ধনের জন্য নির্বাচিত পরিমাণ সংরক্ষিত থাকবে। স্বয়ংক্রিয় মাসিক বা বার্ষিক চাঁদা তৈরি হবে না।</p>
<div><button class="btn btn-primary">নিবন্ধন করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">তালিকায় ফিরুন</a></div>
</form></div>
