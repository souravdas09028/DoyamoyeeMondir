@model DoyamoyeeMondir.Web.Models.ResetUserPasswordForm
@{ ViewData["Title"]="পাসওয়ার্ড পুনর্নির্ধারণ"; }
<div class="container-xl py-4"><h1>পাসওয়ার্ড পুনর্নির্ধারণ</h1><p>@ViewBag.Email</p><form asp-action="ResetPassword" method="post" class="card card-body" style="max-width:640px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Stamp" type="hidden"/>
<p>এই কাজের পরে পুরোনো পাসওয়ার্ড ও লগইন সেশন বাতিল হবে। সাময়িক লগইন লকও খুলে যাবে।</p>
<label asp-for="Password">নতুন পাসওয়ার্ড</label><input asp-for="Password" autocomplete="new-password" class="form-control mb-3"/>
<label asp-for="ConfirmPassword">নতুন পাসওয়ার্ড আবার লিখুন</label><input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control mb-3"/>
<p class="text-muted">অন্তত ৮ অক্ষর, ইংরেজি বড় ও ছোট অক্ষর এবং সংখ্যা ব্যবহার করুন। নতুন পাসওয়ার্ড ব্যবহারকারীকে ব্যক্তিগতভাবে দিন।</p>
<div><button class="btn btn-primary">নতুন পাসওয়ার্ড সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
