@model List<DoyamoyeeMondir.Domain.Entities.UserAudit>
@{ ViewData["Title"]="ব্যবহারকারী পরিবর্তনের ইতিহাস"; Dictionary<string,string> names=ViewBag.Names; }
<div class="container-xl py-4"><h1>ব্যবহারকারী পরিবর্তনের ইতিহাস</h1><div class="table-responsive"><table class="table table-striped"><thead><tr><th>সময় (UTC)</th><th>ব্যবহারকারী</th><th>পরিবর্তনকারী</th><th>বিবরণ</th></tr></thead><tbody>
@foreach(var a in Model) { <tr><td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@names.GetValueOrDefault(a.UserId,a.UserId)</td><td>@names.GetValueOrDefault(a.CreatedBy??"",a.CreatedBy??"সিস্টেম")</td><td>@a.Action</td></tr> }
@if(Model.Count==0) { <tr><td colspan="4">এখনো কোনো পরিবর্তন নথিভুক্ত হয়নি।</td></tr> }
</tbody></table></div><partial name="_Pager"/><a asp-action="Index" class="btn btn-outline-primary mt-3">ব্যবহারকারী তালিকা</a></div>
