@model DoyamoyeeMondir.Web.Models.IncomeForm
@{ ViewData["Title"] = Model.MembershipId.HasValue ? "চাঁদা সংগ্রহ" : Model.TempleServiceId.HasValue ? "সেবার ফি সংগ্রহ" : "আয় ও অনুদান সংগ্রহ"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1>
<form method="post" asp-action="Create" class="card card-body mt-3" style="max-width:720px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="SubmissionKey" type="hidden"/><input asp-for="MembershipId" type="hidden"/><input asp-for="TempleServiceId" type="hidden"/><input asp-for="ServiceVersion" type="hidden"/>
<label asp-for="Date" class="form-label">তারিখ (গ্রেগরিয়ান)</label><input asp-for="Date" type="date" class="form-control mb-3"/>
<label asp-for="IncomeCategoryId" class="form-label">আয়ের খাত</label><select asp-for="IncomeCategoryId" asp-items="ViewBag.Categories" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="CashBankAccountId" class="form-label">যে হিসাবে টাকা জমা হয়েছে</label><select asp-for="CashBankAccountId" asp-items="ViewBag.Accounts" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
@if(Model.MembershipId.HasValue) { <input asp-for="PersonId" type="hidden"/><p>সদস্যপদ নম্বর: @Model.MembershipId</p> }
else {
<label asp-for="PersonId" class="form-label">নিবন্ধিত দাতা (ঐচ্ছিক)</label><select asp-for="PersonId" asp-items="ViewBag.People" class="form-select mb-3"><option value="">অনিবন্ধিত / নাম প্রকাশে অনিচ্ছুক</option></select>
<label asp-for="PayerName" class="form-label">অনিবন্ধিত দাতার নাম (ঐচ্ছিক)</label><input asp-for="PayerName" class="form-control mb-3"/>
}
<label asp-for="Amount" class="form-label">পরিমাণ (টাকা)</label>
@if(Model.TempleServiceId.HasValue) { <input asp-for="Amount" type="number" step="0.01" readonly class="form-control mb-3"/> }
else { <input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control mb-3"/> }
<label asp-for="PaymentMethod" class="form-label">পরিশোধ পদ্ধতি</label><select asp-for="PaymentMethod" class="form-select mb-3"><option value="1">নগদ</option><option value="2">ব্যাংক স্থানান্তর</option><option value="3">চেক</option><option value="4">মোবাইল ব্যাংকিং</option><option value="5">কার্ড</option><option value="6">অনলাইন</option><option value="7">অন্যান্য</option></select>
<label asp-for="Reference" class="form-label">লেনদেন / চেক নম্বর (ঐচ্ছিক)</label><input asp-for="Reference" class="form-control mb-3"/>
<label asp-for="Description" class="form-label">বিবরণ</label><textarea asp-for="Description" class="form-control mb-3"></textarea>
<div><button class="btn btn-primary">সংরক্ষণ ও রসিদ</button> <a asp-action="Index" class="btn btn-outline-secondary">তালিকায় ফিরুন</a></div>
</form></div>
