@model DoyamoyeeMondir.Domain.Entities.Income
@{ ViewData["Title"] = "রসিদ"; }
@section Styles { <style>@@media print { .navbar, .temple-sidebar, .no-print, footer { display:none!important; } .page-wrapper { margin:0!important; } .receipt { box-shadow:none!important; border:1px solid #333!important; } }</style> }
<div class="container-xl py-4"><div class="card card-body receipt mx-auto" style="max-width:760px">
<h1 class="text-center">দয়াময়ী মন্দির</h1><h2 class="text-center h3">অর্থ গ্রহণের রসিদ</h2><hr/>
<p><strong>রসিদ নম্বর:</strong> R-@Model.Id.ToString("D8") <span class="float-end"><strong>তারিখ:</strong> @Model.Date.ToString("yyyy-MM-dd")</span></p>
<dl class="row"><dt class="col-sm-4">দাতার নাম</dt><dd class="col-sm-8">@Model.PayerName</dd><dt class="col-sm-4">আয়ের খাত</dt><dd class="col-sm-8">@Model.CategoryName</dd><dt class="col-sm-4">বিবরণ</dt><dd class="col-sm-8">@Model.Description</dd><dt class="col-sm-4">হিসাব</dt><dd class="col-sm-8">@Model.AccountName</dd><dt class="col-sm-4">পরিমাণ</dt><dd class="col-sm-8"><strong>@Model.Amount.ToString("N2") টাকা</strong></dd><dt class="col-sm-4">পদ্ধতি</dt><dd class="col-sm-8">@(Model.PaymentMethod switch { DoyamoyeeMondir.Domain.Enums.PaymentMethod.Cash => "নগদ", DoyamoyeeMondir.Domain.Enums.PaymentMethod.BankTransfer => "ব্যাংক স্থানান্তর", DoyamoyeeMondir.Domain.Enums.PaymentMethod.Cheque => "চেক", DoyamoyeeMondir.Domain.Enums.PaymentMethod.MobileBanking => "মোবাইল ব্যাংকিং", DoyamoyeeMondir.Domain.Enums.PaymentMethod.Card => "কার্ড", DoyamoyeeMondir.Domain.Enums.PaymentMethod.OnlinePayment => "অনলাইন", _ => "অন্যান্য" })</dd><dt class="col-sm-4">লেনদেন নম্বর</dt><dd class="col-sm-8">@(Model.Reference ?? "—")</dd></dl>
@if(Model.MembershipId.HasValue) { <p>সদস্যপদ নম্বর: @Model.MembershipId</p> }
@if(Model.TempleServiceId.HasValue) { <p>@Model.ServiceName — মন্দির: @Model.TempleShare.ToString("N2"), পুরোহিত: @Model.PriestShare.ToString("N2"), কর্মচারী: @Model.StaffShare.ToString("N2") টাকা</p> }
<p class="mt-5">গ্রহণকারীর স্বাক্ষর: ____________________</p>
</div><div class="no-print d-flex gap-2 justify-content-center mt-3"><button type="button" onclick="window.print()" class="btn btn-primary">রসিদ প্রিন্ট করুন</button><a asp-action="Index" class="btn btn-outline-secondary">সংগ্রহের তালিকা</a></div></div>
