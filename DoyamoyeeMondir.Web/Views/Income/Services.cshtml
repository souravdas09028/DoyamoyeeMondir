@model List<DoyamoyeeMondir.Domain.Entities.TempleService>
@{ ViewData["Title"] = "পূজা ও সেবার ফি"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><div class="row g-3 mt-2">
@foreach(var s in Model) { <div class="col-md-4"><div class="card card-body h-100"><h2 class="h3">@s.NameBn</h2><p>মূল্য: @s.Amount.ToString("N2") টাকা</p><p>মন্দির: @s.TempleShare.ToString("N2") · পুরোহিত: @s.PriestShare.ToString("N2") · কর্মচারী: @s.StaffShare.ToString("N2")</p>@if(s.Amount > 0) { <a asp-action="Create" asp-route-serviceId="@s.Id" class="btn btn-primary">ফি সংগ্রহ</a> } else { <p>বিনামূল্যের সেবা</p> }</div></div> }
@if(Model.Count == 0) { <p>এখনো কোনো সক্রিয় সেবা নেই। অ্যাডমিন সেটিংস থেকে সেবা যোগ করুন।</p> }
</div></div>
