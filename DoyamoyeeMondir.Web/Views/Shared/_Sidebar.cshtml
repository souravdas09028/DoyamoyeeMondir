@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="navbar navbar-vertical navbar-expand-lg temple-sidebar"
       data-bs-theme="dark">

    <div class="container-fluid">
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#sidebar-menu"
                aria-controls="sidebar-menu"
                aria-expanded="false"
                aria-label="মেনু খুলুন">

            <span class="navbar-toggler-icon"></span>
        </button>

        <h1 class="navbar-brand navbar-brand-autodark">
            <a asp-controller="Home"
               asp-action="Index"
               class="temple-brand">

                <span class="temple-brand-icon">
                    <i class="ti ti-building-pavilion"></i>
                </span>

                <span class="temple-brand-text">
                    <span class="temple-name">
                        দয়াময়ী মন্দির
                    </span>

                    <span class="temple-subtitle">
                        ব্যবস্থাপনা সিস্টেম
                    </span>
                </span>
            </a>
        </h1>

        <div class="collapse navbar-collapse"
             id="sidebar-menu">

            <ul class="navbar-nav pt-lg-3">

                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="nav-link-icon">
                            <i class="ti ti-layout-dashboard"></i>
                        </span>

                        <span class="nav-link-title">
                            ড্যাশবোর্ড
                        </span>
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#navbar-members"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="false"
                       role="button"
                       aria-expanded="false">

                        <span class="nav-link-icon">
                            <i class="ti ti-users"></i>
                        </span>

                        <span class="nav-link-title">
                            সদস্য ও দাতা
                        </span>
                    </a>

                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-controller="Memberships" asp-action="Index">
                            সদস্য তালিকা
                        </a>

                        <a class="dropdown-item" asp-controller="Memberships" asp-action="Create">
                            নতুন সদস্য
                        </a>

                        <a class="dropdown-item" asp-controller="People" asp-action="Index">
                            দাতা তালিকা
                        </a>

                        <a class="dropdown-item" asp-controller="Memberships" asp-action="Index" asp-route-dueOnly="true">
                            বকেয়া চাঁদা
                        </a>
                    </div>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#navbar-committee"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="false">

                        <span class="nav-link-icon">
                            <i class="ti ti-users-group"></i>
                        </span>

                        <span class="nav-link-title">
                            কমিটি
                        </span>
                    </a>

                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="#">
                            কমিটি তালিকা
                        </a>

                        <a class="dropdown-item" href="#">
                            নতুন কমিটি
                        </a>

                        <a class="dropdown-item" href="#">
                            কমিটির সদস্য
                        </a>
                    </div>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#navbar-income"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="false">

                        <span class="nav-link-icon">
                            <i class="ti ti-cash-banknote"></i>
                        </span>

                        <span class="nav-link-title">
                            আয়
                        </span>
                    </a>

                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-controller="Income" asp-action="Create">
                            নতুন আয়
                        </a>

                        <a class="dropdown-item" asp-controller="Income" asp-action="Index">
                            অনুদান
                        </a>

                        <a class="dropdown-item" asp-controller="Memberships" asp-action="Index">
                            চাঁদা সংগ্রহ
                        </a>

                        <a class="dropdown-item" asp-controller="Income" asp-action="Services">
                            ফি সংগ্রহ
                        </a>
                    </div>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#navbar-expense"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="false">

