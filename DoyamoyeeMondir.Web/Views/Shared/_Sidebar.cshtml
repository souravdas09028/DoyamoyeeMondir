                            <i class="ti ti-receipt-2"></i>
                        </span>

                        <span class="nav-link-title">
                            ব্যয়
                        </span>
                    </a>

                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-controller="Expenses" asp-action="Create">
                            নতুন ব্যয়
                        </a>

                        <a class="dropdown-item" asp-controller="Expenses" asp-action="Index">
                            ব্যয়ের তালিকা
                        </a>

                        <a class="dropdown-item" href="#">
                            পেমেন্ট ভাউচার
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Income" asp-action="Services">
                        <span class="nav-link-icon">
                            <i class="ti ti-flame"></i>
                        </span>

                        <span class="nav-link-title">
                            পূজা ও অনুষ্ঠান
                        </span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <span class="nav-link-icon">
                            <i class="ti ti-bowl-spoon"></i>
                        </span>

                        <span class="nav-link-title">
                            প্রসাদ বিক্রয়
                        </span>
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#navbar-inventory"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="false">

                        <span class="nav-link-icon">
                            <i class="ti ti-package"></i>
                        </span>

                        <span class="nav-link-title">
                            ইনভেন্টরি
                        </span>
                    </a>

                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="#">
                            পণ্যের তালিকা
                        </a>

                        <a class="dropdown-item" href="#">
                            স্টক গ্রহণ
                        </a>

                        <a class="dropdown-item" href="#">
                            স্টক ব্যবহার
                        </a>

                        <a class="dropdown-item" href="#">
                            বর্তমান স্টক
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <span class="nav-link-icon">
                            <i class="ti ti-diamond"></i>
                        </span>

                        <span class="nav-link-title">
                            সম্পদ ও অলংকার
                        </span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <span class="nav-link-icon">
                            <i class="ti ti-user-dollar"></i>
                        </span>

                        <span class="nav-link-title">
                            কর্মচারী ও বেতন
                        </span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <span class="nav-link-icon">
                            <i class="ti ti-files"></i>
