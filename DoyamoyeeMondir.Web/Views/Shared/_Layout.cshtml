@using DoyamoyeeMondir.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager

<!doctype html>
<html lang="bn" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <meta name="description"
          content="দয়াময়ী মন্দির ইনভেন্টরি ও হিসাব ব্যবস্থাপনা সিস্টেম" />

    <title>@ViewData["Title"] - দয়াময়ী মন্দির</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/css/tabler.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/temple-theme.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="page">
        @if (SignInManager.IsSignedIn(User))
        {
            <partial name="_Sidebar" />
        }

        <div class="page-wrapper">
            @if (SignInManager.IsSignedIn(User))
            {
                <partial name="_TopNavbar" />
            }

            <div class="page-body">
                <div class="container-xl">
                    <partial name="_NotificationPartial" />

                    @RenderBody()
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl">
                    <div class="row align-items-center">
                        <div class="col">
                            <span class="text-muted">
                                &copy; @DateTime.Now.Year
                                দয়াময়ী মন্দির ব্যবস্থাপনা সিস্টেম
                            </span>
                        </div>

                        <div class="col-auto">
                            <span class="text-muted">
                                সংস্করণ ১.০.০
                            </span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/js/tabler.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>