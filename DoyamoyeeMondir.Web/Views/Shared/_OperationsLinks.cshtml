@if(User.IsInRole("SuperAdmin") || User.IsInRole("TempleAdmin") || User.IsInRole("Accountant") || User.IsInRole("Treasurer") || User.IsInRole("Auditor")) { <a asp-controller="Reconciliation" asp-action="Index" class="btn btn-outline-primary">ব্যাংক সমন্বয়</a> }
