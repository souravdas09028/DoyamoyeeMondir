@model DoyamoyeeMondir.Web.Models.InventoryForm
@{ ViewData["Title"] = "পণ্যের তথ্য"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><form asp-action="Edit" method="post" class="card card-body mt-3" style="max-width:720px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/>
<label asp-for="NameBn">পণ্যের নাম</label><input asp-for="NameBn" class="form-control mb-3"/>
<label asp-for="Unit">একক (কেজি / লিটার / পিস)</label><input asp-for="Unit" class="form-control mb-3"/>
<label asp-for="ReorderLevel">কম মজুত সতর্কতার সীমা</label><input asp-for="ReorderLevel" type="number" min="0" step="0.001" class="form-control mb-3"/>
<label class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><span class="form-check-label">সক্রিয়</span></label><p>প্রারম্ভিক মজুতসহ সব পরিমাণ গ্রহণ বা ব্যবহার ফর্মে নথিভুক্ত করুন।</p>
<div><button class="btn btn-primary">সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
