@model DoyamoyeeMondir.Web.Models.StockForm
@{ var item = (DoyamoyeeMondir.Domain.Entities.InventoryItem)ViewBag.Item; ViewData["Title"] = Model.IsReceipt ? "মজুত গ্রহণ" : "মজুত ব্যবহার"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><p>@item.NameBn · বর্তমান: @item.Quantity.ToString("0.###") @item.Unit</p><form asp-action="Move" method="post" class="card card-body" style="max-width:720px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="InventoryItemId" type="hidden"/><input asp-for="IsReceipt" type="hidden"/><input asp-for="SubmissionKey" type="hidden"/>
<label asp-for="Date">তারিখ</label><input asp-for="Date" type="date" class="form-control mb-3"/>
<label asp-for="Quantity">পরিমাণ (@item.Unit)</label><input asp-for="Quantity" type="number" min="0.001" step="0.001" class="form-control mb-3"/>
<label asp-for="Reason">কারণ / উৎস / ব্যবহার</label><textarea asp-for="Reason" class="form-control mb-3"></textarea>
<div><button class="btn btn-primary">সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
