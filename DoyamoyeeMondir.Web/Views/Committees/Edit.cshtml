@model DoyamoyeeMondir.Web.Models.CommitteeForm
@{ ViewData["Title"] = "কমিটির তথ্য"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><form asp-action="Edit" method="post" class="card card-body mt-3" style="max-width:720px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/>
<label asp-for="NameBn">কমিটির নাম</label><input asp-for="NameBn" class="form-control mb-3"/>
<label asp-for="StartDate">মেয়াদ শুরু</label><input asp-for="StartDate" type="date" class="form-control mb-3"/>
<label asp-for="EndDate">মেয়াদ শেষ</label><input asp-for="EndDate" type="date" class="form-control mb-3"/>
<label asp-for="Notes">মন্তব্য (ঐচ্ছিক)</label><textarea asp-for="Notes" class="form-control mb-3"></textarea>
<div><button class="btn btn-primary">সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
