@model DoyamoyeeMondir.Web.Models.PaymentForm
@{ ViewData["Title"] = "ব্যয় পরিশোধ"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><p>ব্যয় নম্বর: @Model.ExpenseId</p>
<form asp-action="Pay" method="post" class="card card-body" style="max-width:720px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="ExpenseId" type="hidden"/><input asp-for="SubmissionKey" type="hidden"/>
<label asp-for="CashBankAccountId">পরিশোধের হিসাব</label><select asp-for="CashBankAccountId" asp-items="ViewBag.Accounts" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="Payee">প্রাপকের নাম</label><input asp-for="Payee" class="form-control mb-3"/>
<label asp-for="Date">পরিশোধের তারিখ</label><input asp-for="Date" type="date" class="form-control mb-3"/>
<label asp-for="Amount">পরিমাণ (টাকা)</label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control mb-3"/>
<label asp-for="PaymentMethod">পরিশোধ পদ্ধতি</label><select asp-for="PaymentMethod" class="form-select mb-3"><option value="1">নগদ</option><option value="2">ব্যাংক স্থানান্তর</option><option value="3">চেক</option><option value="4">মোবাইল ব্যাংকিং</option><option value="5">কার্ড</option><option value="6">অনলাইন</option><option value="7">অন্যান্য</option></select>
<label asp-for="Reference">লেনদেন / চেক নম্বর</label><input asp-for="Reference" class="form-control mb-3"/>
<div><button class="btn btn-primary">পরিশোধ সংরক্ষণ করুন</button> <a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
