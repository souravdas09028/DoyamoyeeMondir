@model DoyamoyeeMondir.Web.Models.AssetForm
@{ ViewData["Title"] = "সম্পদের তথ্য"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><form asp-action="Edit" method="post" class="card card-body mt-3" style="max-width:720px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/>
<label asp-for="NameBn">সম্পদের নাম</label><input asp-for="NameBn" class="form-control mb-3"/>
<label asp-for="Code">স্বতন্ত্র কোড</label><input asp-for="Code" class="form-control mb-3"/>
<label asp-for="Description">বিবরণ / শনাক্তকরণ চিহ্ন</label><textarea asp-for="Description" class="form-control mb-3"></textarea>
<label asp-for="Location">সংরক্ষণের স্থান</label><input asp-for="Location" class="form-control mb-3"/>
<label asp-for="Custodian">দায়িত্বপ্রাপ্ত ব্যক্তি</label><input asp-for="Custodian" class="form-control mb-3"/>
<label asp-for="Material">উপাদান (ঐচ্ছিক)</label><input asp-for="Material" class="form-control mb-3"/>
<label asp-for="WeightGrams">ওজন (গ্রাম, ঐচ্ছিক)</label><input asp-for="WeightGrams" type="number" min="0" step="0.001" class="form-control mb-3"/>
<label asp-for="EstimatedValue">আনুমানিক মূল্য (টাকা, ঐচ্ছিক)</label><input asp-for="EstimatedValue" type="number" min="0" step="0.01" class="form-control mb-3"/>
<label asp-for="DonorId">দাতা (ঐচ্ছিক)</label><select asp-for="DonorId" asp-items="ViewBag.People" class="form-select mb-3"><option value="">প্রযোজ্য নয়</option></select>
<label asp-for="ReceivedDate">প্রাপ্তির তারিখ</label><input asp-for="ReceivedDate" type="date" class="form-control mb-3"/>
<label class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><span class="form-check-label">সক্রিয়</span></label>
<div><button class="btn btn-primary">সংরক্ষণ করুন</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
