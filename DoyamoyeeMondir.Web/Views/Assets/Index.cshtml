@model List<DoyamoyeeMondir.Domain.Entities.TempleAsset>
@{ ViewData["Title"] = "সম্পদ ও অলংকার"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1><a asp-action="Edit" class="btn btn-primary my-3">নতুন সম্পদ</a>
<form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Q" class="form-control" aria-label="নাম বা কোড" placeholder="নাম বা কোড"/><button class="btn btn-outline-primary">খুঁজুন</button></form>
<div class="card table-responsive"><table class="table"><thead><tr><th>কোড / নাম</th><th>বিবরণ</th><th>অবস্থান / দায়িত্বপ্রাপ্ত</th><th>দাতা / প্রাপ্তি</th><th>ওজন / মূল্য</th><th>কাজ</th></tr></thead><tbody>
@foreach(var a in Model) { <tr><td>@a.Code<br/>@a.NameBn @if(!a.IsActive) { <small>নিষ্ক্রিয়</small> }</td><td>@a.Description<br/>@a.Material</td><td>@a.Location<br/>@a.Custodian</td><td>@(a.Donor?.NameBn ?? "—")<br/>@a.ReceivedDate.ToString("yyyy-MM-dd")</td><td>@(a.WeightGrams?.ToString("0.###") ?? "—") গ্রাম<br/>@(a.EstimatedValue?.ToString("N2") ?? "—") টাকা</td><td><a asp-action="Edit" asp-route-id="@a.Id">সম্পাদনা</a></td></tr> }
@if(Model.Count == 0) { <tr><td colspan="6">কোনো সম্পদ নেই।</td></tr> }
</tbody></table></div><partial name="_Pager"/></div>
