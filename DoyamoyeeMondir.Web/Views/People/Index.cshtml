@model List<DoyamoyeeMondir.Domain.Entities.Person>
@{ ViewData["Title"] = "ভক্ত ও দাতার তালিকা"; }
<div class="container-xl py-4"><h1>@ViewData["Title"]</h1>
<div class="d-flex flex-wrap gap-2 my-3"><a asp-action="Edit" class="btn btn-primary">নতুন ব্যক্তি</a><a asp-controller="Memberships" asp-action="Index" class="btn btn-outline-primary">সদস্যপদ</a></div>
<form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Q" class="form-control" aria-label="নাম বা মোবাইল নম্বর" placeholder="নাম বা মোবাইল নম্বর"/><button class="btn btn-outline-primary">খুঁজুন</button></form>
<div class="card table-responsive"><table class="table"><thead><tr><th>নাম</th><th>মোবাইল</th><th>ঠিকানা</th><th>অবস্থা</th><th>কাজ</th></tr></thead><tbody>
@foreach(var p in Model) { <tr><td>@p.NameBn<br/><small>@p.NameEn</small></td><td>@p.MobileNumber</td><td>@p.AddressBn</td><td>@(p.IsActive ? "সক্রিয়" : "নিষ্ক্রিয়")</td><td><a asp-action="Edit" asp-route-id="@p.Id">সম্পাদনা</a> · <a asp-controller="Memberships" asp-action="Create" asp-route-personId="@p.Id">সদস্যপদ দিন</a> · <a asp-controller="Income" asp-action="Index" asp-route-personId="@p.Id">সংগ্রহের ইতিহাস</a></td></tr> }
@if(Model.Count == 0) { <tr><td colspan="5">কোনো ব্যক্তি পাওয়া যায়নি।</td></tr> }
</tbody></table></div>
<nav class="d-flex gap-3 mt-3" aria-label="পৃষ্ঠা">@if(ViewBag.Page > 1) { <a asp-route-q="@ViewBag.Q" asp-route-page="@(ViewBag.Page - 1)">আগের পৃষ্ঠা</a> } @if(ViewBag.HasNext) { <a asp-route-q="@ViewBag.Q" asp-route-page="@(ViewBag.Page + 1)">পরের পৃষ্ঠা</a> }</nav>
</div>
