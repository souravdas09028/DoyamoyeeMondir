@model DoyamoyeeMondir.Web.Models.ReconciliationForm
@{ ViewData["Title"]="স্টেটমেন্ট যাচাই"; }
<div class="container-xl py-4"><h1>স্টেটমেন্ট যাচাই</h1><form asp-action="Create" method="post" class="card card-body" style="max-width:640px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="SubmissionKey" type="hidden"/>
<label asp-for="AccountId">ব্যাংক হিসাব</label><select asp-for="AccountId" asp-items="ViewBag.Accounts" class="form-select mb-3"><option value="">নির্বাচন করুন</option></select>
<label asp-for="Date">স্টেটমেন্টের শেষ তারিখ</label><input asp-for="Date" type="date" class="form-control mb-3"/>
<label asp-for="StatementBalance">স্টেটমেন্টের স্থিতি (টাকা)</label><input asp-for="StatementBalance" type="number" step="0.01" class="form-control mb-3"/>
<label asp-for="Reference">স্টেটমেন্ট নম্বর / বিবরণ</label><input asp-for="Reference" class="form-control mb-3"/>
@if(User.IsInRole("SuperAdmin") || User.IsInRole("TempleAdmin")) { <label class="form-check mb-3"><input asp-for="Close" class="form-check-input"/><span class="form-check-label">স্থিতি মিলে গেলে এই তারিখ পর্যন্ত হিসাব বন্ধ করুন</span></label> }
<p>অমিল থাকলে বন্ধ না করে সংরক্ষণ করুন। লেনদেনের খাতা থেকে পার্থক্য যাচাই করে প্রয়োজনীয় সংশোধন করুন।</p><div><button class="btn btn-primary">যাচাই ও সংরক্ষণ</button> <a asp-action="Index" class="btn btn-outline-secondary">ফিরুন</a></div></form></div>
