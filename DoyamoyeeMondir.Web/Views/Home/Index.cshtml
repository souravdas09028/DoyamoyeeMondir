@{
    ViewData["Title"] = "ড্যাশবোর্ড";
}
@model DoyamoyeeMondir.Web.Models.DashboardSummary

<div class="container py-5">
    <div class="text-center">
        <h1 class="display-5 fw-bold">
            দয়াময়ী মন্দির ব্যবস্থাপনা সিস্টেম
        </h1>

        <p class="lead mt-3">
            মন্দিরের আয়, ব্যয়, অনুদান, চাঁদা, ইনভেন্টরি ও হিসাব ব্যবস্থাপনা
        </p>
    </div>

    <partial name="_OperationsLinks" />
    @if(Model.ShowFinance) {
    <div class="row mt-5 g-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">আজকের আয়</h5>
                    <h3>৳ @Model.TodayIncome.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">আজকের অনুমোদিত ব্যয়</h5>
                    <h3>৳ @Model.TodayExpenses.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">বর্তমান সদস্য</h5>
                    <h3>@Model.MemberCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">অনুমোদনের অপেক্ষায়</h5>
                    <h3>@Model.PendingCount</h3>
                </div>
            </div>
        </div>
    </div>
    }
</div>
